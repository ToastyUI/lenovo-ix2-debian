#!/bin/sh
# ts41x-alert "<subject>" "<body>": mail an alert to the owner via msmtp.
# Recipient comes from /etc/ts41x/alert.conf (ALERT_TO=...), never from this repo.
# Rate-limited: the same subject is sent at most once per 6 hours.
subject=$1 body=$2
conf=/etc/ts41x/alert.conf
[ -r "$conf" ] || { logger -t ts41x-alert "no $conf: alert not mailed: $subject"; exit 0; }
# shellcheck source=/dev/null
. "$conf"
[ -n "${ALERT_TO:-}" ] || exit 0
stamp=/run/ts41x/alert.$(printf '%s' "$subject" | md5sum | cut -c1-12)
mkdir -p /run/ts41x
if [ -e "$stamp" ] && [ $(( $(date +%s) - $(stat -c %Y "$stamp") )) -lt 21600 ]; then exit 0; fi
touch "$stamp"
host=$(hostname)
printf 'To: %s\nSubject: [%s] %s\nContent-Type: text/plain; charset=UTF-8\n\n%s\n\n-- \n%s, %s\n' \
  "$ALERT_TO" "$host" "$subject" "$body" "$host" "$(date '+%Y-%m-%d %H:%M')" \
  | msmtp -t && logger -t ts41x-alert "mailed: $subject"
