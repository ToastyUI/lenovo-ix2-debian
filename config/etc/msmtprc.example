# Copy locally to /etc/msmtprc (root:root, mode 0600).
# Replace both addresses. Store your app password ONLY on the NAS.
defaults
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog LOG_MAIL

account gmail
host smtp.gmail.com
port 587
from YOUR_ACCOUNT@gmail.com
user YOUR_ACCOUNT@gmail.com
passwordeval "cat /etc/ix2-secrets/gmail-app-password"

account default : gmail
